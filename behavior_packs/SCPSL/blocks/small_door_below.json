{ 
  "format_version": "1.21.60", 
  "minecraft:block": { 
    "description": { 
      "identifier": "scp:small_door_below",
      "menu_category": {
        "category": "construction",
        "group": "minecraft:itemGroup.name.planks"
        },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      },
      "states": {
        "door:open": ["false", "true", "ft", "f-t", "tf", "t-f"]
      }
    },
    "components": {
      "scp:small_door_below": {
        "control": "door:open",
        "direction": "minecraft:cardinal_direction"
      },
      "minecraft:geometry": "geometry.small_door_below_close", 
      "minecraft:item_visual": {
        "geometry": "geometry.small_door_below_item",
        "material_instances": {
          "*": {
            "texture": "small_door_below_item",
            "render_method": "alpha_test"
          }
        }
      },
      "minecraft:material_instances": {
      "*": { 
        "texture": "small_door",
        "render_method": "alpha_test"
      } 
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -1],
        "size": [16, 16, 2]
      },
      "minecraft:selection_box":{
        "origin": [-8, 0, -1],
        "size": [16, 16, 2]
      },
      "minecraft:movable": {
        "movement_type": "popped"
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' || q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 0, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' || q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('door:open') == 'false'",
        "components": {
          "minecraft:geometry": "geometry.small_door_below_close"
        }
      },
      {
        "condition": "q.block_state('door:open') == 'true'",
        "components": {
          "minecraft:collision_box": {
            "origin": [0, 0, 0],
            "size": [0, 0, 0]
          },
          "minecraft:geometry": "geometry.small_door_below_open"
        }
      },
      {
        "condition": "q.block_state('door:open') == 'ft'",
        "components": {
          "minecraft:geometry": "geometry.null"
        }
      },
      {
        "condition": "q.block_state('door:open') == 'f-t'",
        "components": {
          "minecraft:collision_box": {
            "origin": [0, 0, 0],
            "size": [0, 0, 0]
          },
          "minecraft:geometry": "geometry.null"
        }
      },
      {
        "condition": "q.block_state('door:open') == 'tf'",
        "components": {
          "minecraft:collision_box": {
            "origin": [0, 0, 0],
            "size": [0, 0, 0]
          },
          "minecraft:geometry": "geometry.null"
        }
      },
      {
        "condition": "q.block_state('door:open') == 't-f'",
        "components": {
          "minecraft:geometry": "geometry.null"
        }
      }
    ]
  } 
} 
