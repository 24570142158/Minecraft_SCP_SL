{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.small_door": {
			"states": {
				"default": {
					"transitions": [
						{ "playing": "q.property('door:animate')" }
					]
				},
				"playing": {
					"animations": [
						{"small_door_open": "!q.property('door:open')"},
						{"small_door_close": "q.property('door:open')"}
					]
				}
			}
		}
	}
}
